{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/compare.js": {
      "includeFiles": "compare.html"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index-v2.html"
    },
    {
      "source": "/dubai-city-tour-bus",
      "destination": "/api/compare?city=dubai"
    },
    {
      "source": "/berlin-city-tour-bus",
      "destination": "/api/compare?city=berlin"
    },
    {
      "source": "/madrid-city-tour-bus",
      "destination": "/api/compare?city=madrid"
    },
    {
      "source": "/sydney-city-tour-bus",
      "destination": "/api/compare?city=sydney"
    },
    {
      "source": "/compare",
      "destination": "/api/compare"
    },
    {
      "source": "/compare/:path*",
      "destination": "/api/compare"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/route-check/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/hk-nearby-place-search.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/index-v2.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/search-quiz.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/search-quiz.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/prices.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=1800"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/route-check/new-york",
      "destination": "/new-york-route-check",
      "permanent": false
    },
    {
      "source": "/route-check/hong-kong",
      "destination": "/hong-kong-route-check",
      "permanent": false
    },
    {
      "source": "/new-york-route-prototype.html",
      "destination": "/new-york-route-check",
      "permanent": true
    },
    {
      "source": "/new-york-route-prototype",
      "destination": "/new-york-route-check",
      "permanent": true
    },
    {
      "source": "/hong-kong-route-prototype.html",
      "destination": "/hong-kong-route-check",
      "permanent": true
    },
    {
      "source": "/hong-kong-route-prototype",
      "destination": "/hong-kong-route-check",
      "permanent": true
    }
  ]
}
