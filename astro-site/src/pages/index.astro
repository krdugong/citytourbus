---
import Base from '../layouts/Base.astro';
import CityCard from '../components/CityCard.astro';
import { cities, countries, latestDate } from '../lib/data.mjs';
import { SITE_NAME, absolute, pathFor } from '../lib/site.mjs';
const recent = [...cities].sort((a,b) => latestDate(b).localeCompare(latestDate(a))).slice(0,4);
const schemas = [{ '@context':'https://schema.org', '@type':'WebSite', name:SITE_NAME, url:absolute('/') }, { '@context':'https://schema.org', '@type':'Organization', name:SITE_NAME, url:absolute('/') }];
---
<Base title={`전 세계 시티투어버스 비교 | ${SITE_NAME}`} description="도시별 시티투어버스 상품의 노선, 가격, 이용 조건을 한곳에서 비교합니다. 입력된 정보만 표시하며 최신 조건은 운영사에서 확인할 수 있습니다." schemas={schemas}>
  <section class="bg-gradient-to-br from-[#087fae] via-[#11699d] to-[#143b71] py-20 text-white">
    <div class="container grid items-center gap-10 md:grid-cols-[1.1fr_.9fr]">
      <div><p class="text-sm font-bold tracking-[.2em] text-sky-100">CITYTOURBUS</p><h1 class="mt-5 max-w-2xl text-4xl font-black leading-tight md:text-6xl">전 세계 시티투어버스를 한곳에서 비교하세요.</h1><p class="mt-6 max-w-xl leading-8 text-sky-50">도시를 선택하면 입력된 운영사와 상품의 노선, 가격, 이용 조건을 한눈에 확인할 수 있습니다.</p><form action={pathFor('/city/')} method="get" class="mt-8 flex max-w-xl gap-2 rounded-full bg-white p-2"><label for="hub-search" class="sr-only">도시 검색</label><input id="hub-search" name="q" placeholder="어디로 가시나요? 도시를 검색하세요" class="min-w-0 flex-1 px-4 text-sm text-slate-800 outline-none" /><button class="rounded-full bg-[#ffb247] px-6 py-3 text-sm font-black text-[#173047]">비교하기</button></form></div>
      <div class="rounded-[2rem] border border-white/20 bg-white/10 p-7 backdrop-blur"><p class="text-sm text-sky-100">서비스 도시</p><p class="mt-2 text-5xl font-black">{cities.length}<span class="ml-2 text-lg">개 도시</span></p><div class="mt-8 grid grid-cols-2 gap-3">{cities.slice(0,4).map(c => <a class="rounded-2xl bg-white/15 p-4 hover:bg-white/25" href={pathFor(`/city/${c.city_slug}/`)}><span class="block text-xs text-sky-100">{c.country}</span><strong class="mt-1 block">{c.city} 비교 →</strong></a>)}</div></div>
    </div>
  </section>
  <section class="container py-16"><div class="flex flex-wrap items-end justify-between gap-4"><div><p class="eyebrow">Featured cities</p><h2 class="mt-2 text-3xl font-black">주요 도시</h2></div><a href={pathFor('/city/')} class="font-bold text-sky-700">전체 도시 보기 →</a></div><div class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{cities.slice(0,6).map(city => <CityCard city={city} />)}</div></section>
  <section class="bg-white py-16"><div class="container"><p class="eyebrow">Explore by country</p><h2 class="mt-2 text-3xl font-black">국가별 도시 목록</h2>{countries.map(country => <div class="mt-7"><h3 class="text-lg font-bold">{country}</h3><div class="mt-3 flex flex-wrap gap-3">{cities.filter(c => c.country === country).map(c => <a class="rounded-full border border-sky-200 px-5 py-2 text-sky-800 hover:bg-sky-50" href={pathFor(`/city/${c.city_slug}/`)}>{c.city} 시티투어버스</a>)}</div></div>)}</div></section>
  <section class="container grid gap-10 py-16 lg:grid-cols-2"><div><p class="eyebrow">Updated cities</p><h2 class="mt-2 text-3xl font-black">최근 업데이트 도시</h2><ul class="mt-6 space-y-3">{recent.map(c => <li class="card flex items-center justify-between p-5"><a class="font-bold text-sky-800" href={pathFor(`/city/${c.city_slug}/`)}>{c.city} 시티투어버스 비교</a><span class="text-sm text-slate-500">{latestDate(c)}</span></li>)}</ul></div><div class="card p-8"><p class="eyebrow">How to compare</p><h2 class="mt-2 text-3xl font-black">여행 일정에 맞춰 비교합니다</h2><p class="mt-5 leading-8 text-slate-600">도시별 페이지에는 CSV에서 확인한 상품 정보만 담습니다. 가격이나 노선이 비어 있으면 추정값을 표시하지 않습니다. 각 운영사의 최신 예약 조건은 연결된 페이지에서 확인하세요.</p><a href={pathFor('/guide/')} class="mt-6 inline-block font-bold text-sky-700">이용 가이드 보기 →</a></div></section>
  <section class="container pb-16"><h2 class="text-2xl font-black">전체 도시 목록</h2><div class="mt-5 flex flex-wrap gap-3">{cities.map(c => <a class="text-sky-800 underline" href={pathFor(`/city/${c.city_slug}/`)}>{c.city} 시티투어버스 비교</a>)}</div></section>
</Base>
