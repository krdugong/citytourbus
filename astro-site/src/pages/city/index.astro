---
import Base from '../../layouts/Base.astro';
import CityCard from '../../components/CityCard.astro';
import { cities, countries } from '../../lib/data.mjs';
const count = cities.length;
---
<Base title={`전체 도시 시티투어버스 비교 | CITYTOURBUS`} description={`${count}개 도시의 시티투어버스 상품을 찾고 비교합니다.`} path="/city/">
  <section class="bg-[#eaf6fc] py-14"><div class="container"><p class="eyebrow">All cities</p><h1 class="mt-2 text-4xl font-black">전체 도시</h1><p class="mt-4 text-slate-600">{count}개 도시의 시티투어버스 상품을 살펴보세요.</p></div></section>
  <section class="container py-12"><div class="card grid gap-4 p-5 sm:grid-cols-[1fr_auto]"><label class="text-sm font-bold">도시 검색<input id="city-search" type="search" placeholder="도시명을 입력하세요" class="mt-2 block w-full rounded-xl border border-slate-200 px-4 py-3" /></label><label class="text-sm font-bold">국가 선택<select id="country-filter" class="mt-2 block w-full rounded-xl border border-slate-200 px-4 py-3"><option value="">전체 국가</option>{countries.map(c => <option value={c}>{c}</option>)}</select></label></div><div id="city-list" class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{cities.map(city => <div data-city={city.city.toLowerCase()} data-country={city.country}><CityCard city={city} /></div>)}</div><p id="empty-result" class="mt-6 hidden text-slate-500">검색 결과가 없습니다.</p></section>
  <script>
    const search = document.querySelector('#city-search');
    const country = document.querySelector('#country-filter');
    const items = [...document.querySelectorAll('#city-list > div')];
    const update = () => { let shown = 0; for (const item of items) { const show = item.dataset.city?.includes(search.value.trim().toLowerCase()) && (!country.value || item.dataset.country === country.value); item.hidden = !show; if (show) shown++; } document.querySelector('#empty-result').classList.toggle('hidden', shown > 0); };
    search.value = new URLSearchParams(location.search).get('q') || ''; update();
    search?.addEventListener('input', update); country?.addEventListener('change', update);
  </script>
</Base>
