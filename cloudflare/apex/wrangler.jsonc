// Redirects the bare domain to www. Deployed separately:
//   npx wrangler deploy -c cloudflare/apex/wrangler.jsonc
// Its custom domain (citytourbus.kr) is attached once the domain is on Cloudflare.
{
  "name": "citytourbus-apex-redirect",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false
}
