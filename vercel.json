{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/compare.js": {
      "includeFiles": "compare.html"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index-v2.html"
    },
    {
      "source": "/compare",
      "destination": "/api/compare"
    },
    {
      "source": "/compare/:path*",
      "destination": "/api/compare"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/route-check/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/hk-nearby-place-search.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/index-v2.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/search-quiz.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/search-quiz.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/prices.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=1800"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "citytourbus.kr"
        }
      ],
      "destination": "https://www.citytourbus.kr/:path*",
      "statusCode": 301
    },
    {
      "source": "/route-check/new-york",
      "destination": "/new-york-route-check",
      "statusCode": 301
    },
    {
      "source": "/route-check/hong-kong",
      "destination": "/hong-kong-route-check",
      "statusCode": 301
    },
    {
      "source": "/new-york-route-prototype.html",
      "destination": "/new-york-route-check",
      "statusCode": 301
    },
    {
      "source": "/new-york-route-prototype",
      "destination": "/new-york-route-check",
      "statusCode": 301
    },
    {
      "source": "/hong-kong-route-prototype.html",
      "destination": "/hong-kong-route-check",
      "statusCode": 301
    },
    {
      "source": "/hong-kong-route-prototype",
      "destination": "/hong-kong-route-check",
      "statusCode": 301
    },
    {
      "source": "/city/paris",
      "destination": "/paris-big-bus",
      "statusCode": 301
    },
    {
      "source": "/city/london",
      "destination": "/london-big-bus",
      "statusCode": 301
    },
    {
      "source": "/city/rome",
      "destination": "/rome-big-bus",
      "statusCode": 301
    },
    {
      "source": "/city/barcelona",
      "destination": "/barcelona-city-tour-bus",
      "statusCode": 301
    },
    {
      "source": "/city/new-york",
      "destination": "/new-york-city-tour-bus",
      "statusCode": 301
    },
    {
      "source": "/city/tokyo",
      "destination": "/tokyo-city-tour-bus",
      "statusCode": 301
    },
    {
      "source": "/city",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/paris-city-tour-bus",
      "destination": "/paris-big-bus",
      "statusCode": 301
    },
    {
      "source": "/london-city-tour-bus",
      "destination": "/london-big-bus",
      "statusCode": 301
    },
    {
      "source": "/rome-city-tour-bus",
      "destination": "/rome-big-bus",
      "statusCode": 301
    },
    {
      "source": "/sydney-city-tour-bus",
      "destination": "/sydney-big-bus",
      "statusCode": 301
    }
  ]
}
