---
import Base from '../../layouts/Base.astro';
import { pathFor } from '../../lib/site.mjs';
const guides = Object.entries(import.meta.glob('../../content/guide/*.md', {eager:true})).map(([file,mod]) => ({slug:file.split('/').at(-1).replace('.md',''),...mod.frontmatter}));
---
<Base title="시티투어버스 이용 가이드 | CITYTOURBUS" description="시티투어버스 티켓, 노선, 정류장과 예약 조건을 살펴보는 가이드입니다." path="/guide/"><section class="container py-16"><p class="eyebrow">Travel guide</p><h1 class="mt-2 text-4xl font-black">시티투어버스 이용 가이드</h1><p class="mt-4 text-slate-600">예약 전에 확인하면 좋은 내용을 정리했습니다.</p><div class="mt-9 grid gap-5 md:grid-cols-2">{guides.map(g => <a class="card block p-7 hover:border-sky-400" href={pathFor(`/guide/${g.slug}/`)}><h2 class="text-xl font-black">{g.title}</h2><p class="mt-3 leading-7 text-slate-600">{g.description}</p><span class="mt-5 inline-block text-sm font-bold text-sky-700">글 읽기 →</span></a>)}</div></section></Base>
