---
import Base from '../../layouts/Base.astro';
import { cities, operators, latestDate, relatedCities } from '../../lib/data.mjs';
import { SITE_NAME, absolute, imageUrl, pathFor, freshness, textDate } from '../../lib/site.mjs';
export function getStaticPaths() { return cities.map(city => ({ params:{slug:city.city_slug}, props:{city} })); }
const {city} = Astro.props;
const products = city.products;
const ops = operators(city);
const path = `/city/${city.city_slug}/`;
const title = `${city.city} 시티투어버스 비교 | 노선·가격·예약 | ${SITE_NAME}`;
const description = `${city.city} 시티투어버스 상품과 예약 링크를 비교합니다. 기존 사이트 자료와 확인된 가격 출처를 바탕으로 정리했습니다.`;
const image = imageUrl(city.hero_image || products.find(p => p.image)?.image);
const schemas = [
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{ '@type':'ListItem',position:1,name:'홈',item:absolute('/') },{ '@type':'ListItem',position:2,name:'도시',item:absolute('/city/') },{ '@type':'ListItem',position:3,name:city.city,item:absolute(path) }]},
  {'@context':'https://schema.org','@type':'ItemList',itemListElement:products.map((p,i) => ({'@type':'ListItem',position:i+1,name:p.product_name,url:absolute(`${path}#${p.product_id}`)}))},
  ...(city.faqs.length ? [{'@context':'https://schema.org','@type':'FAQPage',mainEntity:city.faqs.map(f => ({'@type':'Question',name:f.faq_q,acceptedAnswer:{'@type':'Answer',text:f.faq_a}}))}] : [])
];
const fields = [['ticket_type','이용시간'],['route_name','노선'],['route_summary','노선 특징'],['stops_summary','주요 정류장'],['operating_hours','운영시간'],['frequency','배차 간격'],['adult_price','성인 가격'],['child_price','어린이 가격'],['family_price','가족권'],['duration','한 바퀴 소요시간'],['audio_guide','오디오 가이드'],['live_guide','라이브 가이드'],['cancellation','취소 조건'],['highlight','상품 특징']];
const valueFor = (p,key) => ['adult_price','child_price','family_price'].includes(key) ? `${p[key]}${p.currency ? ` ${p.currency}` : ''}` : p[key];
---
<Base title={title} description={description} path={path} image={image} type="article" schemas={schemas}>
  <section class="bg-white py-12"><div class="container"><nav aria-label="브레드크럼" class="text-sm text-slate-500"><a href={pathFor('/')}>홈</a> &gt; <a href={pathFor('/city/')}>도시</a> &gt; <span>{city.city}</span></nav><div class="mt-8 grid items-center gap-8 md:grid-cols-[1.1fr_.9fr]"><div><p class="eyebrow">{city.country}</p><h1 class="mt-2 break-keep text-4xl font-black leading-tight">{city.city} 시티투어버스 비교</h1><p class="mt-5 text-sm text-slate-500">기존 사이트 자료 반영일: {textDate(city.updated_at)} · 운영사 {ops.length}곳 · 상품 {products.length}개</p><p class="mt-5 leading-8 text-slate-700">{city.city_intro}</p><p class="mt-3 text-sm text-slate-500">이 페이지의 예약 링크는 제휴 링크이며 예약 시 사이트가 수수료를 받을 수 있습니다.</p></div>{image && <img src={image} width="1200" height="720" alt={city.hero_image_alt || products[0]?.image_alt} loading="eager" fetchpriority="high" class="aspect-[5/3] w-full rounded-3xl object-cover" />}</div></div></section>
  <div class="container space-y-16 py-14">
    <section><h2 class="text-2xl font-black">{city.city} 시티투어버스 소개</h2><p class="mt-5 max-w-4xl leading-8 text-slate-700">{city.city_intro}</p></section>
    <section><h2 class="text-2xl font-black">한눈에 보는 비교표</h2><div class="card mt-5 overflow-x-auto"><table class="w-full min-w-[720px] text-left text-sm"><thead class="bg-[#eaf6fc] text-slate-700"><tr><th class="p-4">운영사</th><th class="p-4">상품</th><th class="p-4">이용시간</th><th class="p-4">주요 특징</th><th class="p-4">성인 가격</th><th class="p-4">모바일 티켓</th></tr></thead><tbody>{products.map(p => <tr class="border-t border-slate-100"><td class="p-4 font-bold">{p.operator}</td><td class="p-4"><a class="text-sky-700 underline" href={`#${p.product_id}`}>{p.product_name}</a></td><td class="p-4">{p.ticket_type || '확인 필요'}</td><td class="p-4">{p.highlight || '확인 필요'}</td><td class="p-4">{p.adult_price ? valueFor(p,'adult_price') : '확인 필요'}</td><td class="p-4">{p.mobile_ticket === 'yes' ? '가능' : p.mobile_ticket === 'no' ? '불가' : '확인 필요'}</td></tr>)}</tbody></table></div></section>
    <section><h2 class="text-2xl font-black">운영사별 상품</h2><div class="mt-6 grid gap-6">{products.map(p => <article id={p.product_id} class="card overflow-hidden"><div class:list={["grid", p.image ? "md:grid-cols-[320px_1fr]" : "grid-cols-1"]}><div>{p.image && <figure><img src={imageUrl(p.image)} width="1200" height="720" alt={p.image_alt} loading="lazy" class="h-full min-h-56 w-full object-cover" /><figcaption class="px-4 py-2 text-xs text-slate-500">{p.image_caption}</figcaption></figure>}</div><div class="p-6"><p class="eyebrow">{p.operator}</p><h3 class="mt-1 text-xl font-black">{p.product_name}</h3>{freshness(p.verified_at) && <p class="mt-2 inline-block rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-900">{freshness(p.verified_at)}</p>}<dl class="mt-5 grid gap-x-6 gap-y-3 sm:grid-cols-2">{fields.filter(([key]) => p[key]).map(([key,label]) => <div><dt class="text-xs font-bold text-slate-500">{label}</dt><dd class="mt-1 text-sm">{valueFor(p,key)}</dd></div>)}{[['hop_on_hop_off','자유 승하차'],['night_tour','야간 투어'],['mobile_ticket','모바일 티켓']].filter(([key]) => p[key]).map(([key,label]) => <div><dt class="text-xs font-bold text-slate-500">{label}</dt><dd class="mt-1 text-sm">{p[key] === 'yes' ? '가능' : '불가'}</dd></div>)}</dl>{p.verified_at && <p class="mt-5 text-xs text-slate-500">가격 출처 확인일: {textDate(p.verified_at)}</p>}{(p.adult_price || p.child_price) && <p class="mt-2 text-xs text-slate-500">가격은 날짜와 예약 조건에 따라 변경될 수 있으므로 예약 페이지에서 최종 금액을 확인하세요.</p>}<div class="mt-5 flex flex-wrap items-center gap-4">{p.booking_link && <a href={p.booking_link} target="_blank" rel="sponsored nofollow noopener" class="rounded-full bg-[#087fae] px-6 py-3 text-sm font-bold text-white">제휴 예약 페이지에서 확인 →</a>}{p.source && <a href={p.source} target="_blank" rel="noopener noreferrer" class="text-sm text-sky-700 underline">공식 정보 출처</a>}</div></div></div></article>)}</div></section>
    <section class="grid gap-8 md:grid-cols-2"><div class="card p-7"><h2 class="text-2xl font-black">노선 비교 기준</h2>{city.comparison_intro && <p class="mt-4 leading-8 text-slate-700">{city.comparison_intro}</p>}{city.recommended_for && <p class="mt-3 leading-8 text-slate-700">{city.recommended_for}</p>}</div><div class="card p-7"><h2 class="text-2xl font-black">예약 전에 확인할 점</h2>{city.booking_tip && <p class="mt-4 leading-8 text-slate-700">{city.booking_tip}</p>}</div></section>
    <section><h2 class="text-2xl font-black">노선 및 주요 정류장</h2><div class="mt-5 grid gap-4 md:grid-cols-2">{products.filter(p => p.route_name || p.route_summary || p.stops_summary).map(p => <div class="card p-6"><h3 class="font-bold">{p.operator} · {p.product_name}</h3>{p.route_name && <p class="mt-3">노선: {p.route_name}</p>}{p.route_summary && <p class="mt-2">노선 특징: {p.route_summary}</p>}{p.stops_summary && <p class="mt-2">주요 정류장: {p.stops_summary}</p>}</div>)}</div></section>
    {city.faqs.length > 0 && <section><h2 class="text-2xl font-black">자주 묻는 질문</h2><div class="mt-5 space-y-3">{city.faqs.map(f => <details class="card p-5" open><summary class="cursor-pointer font-bold">{f.faq_q}</summary><p class="mt-3 leading-7 text-slate-700">{f.faq_a}</p></details>)}</div></section>}
    <section><h2 class="text-2xl font-black">다른 도시 시티투어버스</h2><div class="mt-5 flex flex-wrap gap-3">{relatedCities(city).map(c => <a href={pathFor(`/city/${c.city_slug}/`)} class="rounded-full border border-sky-200 bg-white px-5 py-2 text-sky-800">{c.city} 시티투어버스 비교</a>)}</div></section>
  </div>
</Base>
